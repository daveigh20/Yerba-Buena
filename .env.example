# Copy to .env for local development. The API server reads it on startup.

# Postgres connection string.
DATABASE_URL=postgres://localhost:5432/yerba_buena

# API server port (the Vite dev server proxies /api here). In production PORT also works.
API_PORT=3001

# Origins allowed to send sign-up/log-in requests (comma-separated). Required in production.
# APP_ORIGIN=http://localhost:5173

# Set when running behind a proxy or load balancer (e.g. 1), so rate limiting sees real client IPs.
# TRUST_PROXY=1

# How long a log-in lasts, in days.
# SESSION_DAYS=30
